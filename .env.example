NODE_ENV=development
PORT=8000
API_PREFIX=/api/v1

# Public URL of this API (used to build default redirect/callback URLs)
PUBLIC_BASE_URL=http://localhost:8000

# Frontend origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://jatparivar.org,https://www.jatparivar.org

# Uploads
# Set this to a persistent path on the VPS (recommended), e.g. /var/www/jatparivar/uploads
# UPLOAD_DIR=/var/www/jatparivar/uploads

# Cookies (prod: true + SameSite=None with HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Mongo
MONGO_URI=

# FAST2SMS (OTP)
FAST2SMS_API_KEY=

# ---------------------------
# PhonePe Standard Checkout (v2) - recommended
# ---------------------------
# If PHONEPE_ENV is not set, backend auto-uses:
# - SANDBOX when NODE_ENV != production OR PUBLIC_BASE_URL is localhost
# - PROD otherwise
# PHONEPE_ENV=SANDBOX
# PHONEPE_ENV=PROD

# Sandbox/Test Mode credentials (from PhonePe portal when TEST MODE is ON)
PHONEPE_SANDBOX_CLIENT_ID=
PHONEPE_SANDBOX_CLIENT_SECRET=
PHONEPE_SANDBOX_CLIENT_VERSION=1

# Production credentials
PHONEPE_PROD_CLIENT_ID=
PHONEPE_PROD_CLIENT_SECRET=
PHONEPE_PROD_CLIENT_VERSION=1

# Backward compatible (optional): single set used if env-specific keys aren't set
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=

# PhonePe callback endpoints (optional)
# Defaults to: ${PUBLIC_BASE_URL}${API_PREFIX}/payments/phonepe/{callback|webhook}
PHONEPE_REDIRECT_URL=
PHONEPE_CALLBACK_URL=

# Optional: enable only if you set webhook auth in PhonePe dashboard.
# PhonePe dashboard "Username/Password" uses HTTP Basic auth.
# This backend also accepts the legacy/custom "Authorization: SHA256 <sha256(username:password)>" format.
PHONEPE_WEBHOOK_AUTH_USERNAME=
PHONEPE_WEBHOOK_AUTH_PASSWORD=

# ---------------------------
# PhonePe legacy v1 (not needed for v2)
# ---------------------------
PHONEPE_BASE_URL=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=

# JWT
JWT_SECRET=dev-secret
JWT_EXPIRES=7d
ADMIN_JWT_SECRET=dev-secret
ADMIN_JWT_EXPIRES=2h
